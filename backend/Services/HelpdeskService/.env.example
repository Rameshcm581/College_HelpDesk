# ==============================================================================
# College AI Help Desk - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS BEFORE STARTING THE APP.
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Application Environment
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8005

# Security & Secrets (Must be at least 32 random characters in production)
# In production, generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-random-32-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Database Configuration (PostgreSQL 16 + pgvector)
# Note: Host port 5435 maps to internal container port 5432 to avoid local port 5432 conflicts.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=college_helpdesk_db
POSTGRES_USER=helpdesk_user
POSTGRES_PASSWORD=your_secure_db_password_here
# Async connection URL for SQLAlchemy asyncpg
DB_URI=postgresql+asyncpg://helpdesk_user:your_secure_db_password_here@localhost:5435/college_helpdesk_db
# Sync connection URL for Alembic migrations
SYNC_DB_URI=postgresql://helpdesk_user:your_secure_db_password_here@localhost:5435/college_helpdesk_db

# Redis Configuration (Cache & Background Queues)
# Note: Host port 6380 maps to internal container port 6379 to avoid local port 6379 conflicts.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@localhost:6380/0

# AI Models & OpenAI Integration (Configurable)
OPENAI_API_KEY=your_openai_api_key_placeholder
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_COMPLETION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RAG_CONFIDENCE_THRESHOLD=0.72

# Storage & Document Uploads
STORAGE_PATH=./backend/storage
MAX_UPLOAD_SIZE_MB=50

# Institutional SMTP Configuration (For Ticket Notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=helpdesk-noreply@example.com
SMTP_PASSWORD=your_smtp_password_placeholder
SMTP_FROM_EMAIL=helpdesk-noreply@college.edu
SMTP_FROM_NAME="College AI Help Desk"
SMTP_USE_TLS=true

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5175,http://localhost:3000,http://127.0.0.1:5175
